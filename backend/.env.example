# --- TRON node / API ---------------------------------------------------
TRON_FULL_HOST=https://api.shasta.trongrid.io
TRON_API_KEY=your_trongrid_api_key
TRON_NETWORK=shasta                 # shasta | nile | mainnet

# --- On-chain contract ---------------------------------------------------
MULTISIG_CONTRACT_ADDRESS=          # base58 address from tronbox migrate output

# --- Server / auth ---------------------------------------------------
PORT=4000
JWT_SECRET=replace_with_a_long_random_string

# --- Database ---------------------------------------------------
DATABASE_URL=postgres://user:password@localhost:5432/tron_wallet

# --- Multisig defaults ---------------------------------------------------
DEFAULT_SIGNATURE_THRESHOLD=2
DEFAULT_SIGNER_COUNT=3

# --- Fee / resource management ---------------------------------------------------
MIN_TRX_RESERVE=50                  # minimum TRX to keep unfrozen for fallback fees
FEE_LIMIT_SUN=100000000             # max fee limit for contract calls (in SUN)
AUTO_STAKE_FOR_ENERGY=true

# --- Sponsor account (transparent fee sponsorship — see README) ---------
# Used ONLY to delegate Bandwidth/Energy to under-resourced wallets.
# Never receives funds from users.
SPONSOR_ACCOUNT_ADDRESS=
SPONSOR_ACCOUNT_PRIVATE_KEY=        # in production: pull from a secrets manager, not this file
SPONSOR_DELEGATION_LIMIT_SUN=5000000
SPONSOR_GRACE_PERIOD_HOURS=24

# --- Signer used for read-only calls / broadcasting fully-signed txs ----
# (Individual owner keys are NEVER stored here — they sign client-side.)
BROADCASTER_PRIVATE_KEY=
